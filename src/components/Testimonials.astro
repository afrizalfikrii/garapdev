---
import siteData from '../data/site.json';

const { eyebrow, heading, items } = siteData.testimonials;

const variantStyles: Record<string, { bg: string; rotate: string; timeClass: string }> = {
  'light-left': { bg: 'bg-surface-container-lowest', rotate: '-rotate-1', timeClass: 'text-primary' },
  'accent-right': { bg: 'bg-primary-container', rotate: 'rotate-1', timeClass: 'text-on-surface' },
};
---

<section class="w-full py-16 lg:py-24 border-b-2 border-on-surface bg-surface-container-low">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="mb-12">
      <span class="font-label-md text-label-md text-secondary uppercase tracking-wider">{eyebrow}</span>
      <h2 class="font-headline-lg text-headline-lg text-on-surface mt-1">{heading}</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {
        items.map((t) => {
          const style = variantStyles[t.variant] ?? variantStyles['light-left'];
          return (
            <div class={`${style.bg} border-2 border-on-surface shadow-[6px_6px_0_#111111] p-6 ${style.rotate}`}>
              <div class="flex items-center justify-between mb-3">
                <span class="font-label-md text-label-md text-on-surface">{t.author}</span>
                <span class={`font-label-sm text-label-sm ${style.timeClass}`}>{t.time}</span>
              </div>
              <p class="font-body-md text-body-md text-on-surface">{t.quote}</p>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
