---
import siteData from '../data/site.json';

const { eyebrow, heading, subheading, items } = siteData.services;

const variantStyles: Record<
  string,
  { colSpan: string; cardBg: string; numClass: string; numStroke: boolean; tagClass: string; descClass: string }
> = {
  'wide-light': {
    colSpan: 'md:col-span-7',
    cardBg: 'bg-surface-container-lowest',
    numClass: 'text-primary-container',
    numStroke: true,
    tagClass: 'bg-primary-container text-on-surface',
    descClass: 'text-on-surface-variant',
  },
  'narrow-muted': {
    colSpan: 'md:col-span-5',
    cardBg: 'bg-surface-container-low',
    numClass: 'text-on-surface',
    numStroke: false,
    tagClass: 'bg-surface-container-lowest text-on-surface',
    descClass: 'text-on-surface-variant',
  },
  'wide-accent': {
    colSpan: 'md:col-span-7',
    cardBg: 'bg-primary-container',
    numClass: 'text-surface-container-lowest',
    numStroke: true,
    tagClass: 'bg-secondary-container text-on-secondary-container',
    descClass: 'text-on-surface',
  },
};
---

<section class="w-full py-16 lg:py-24 border-b-2 border-on-surface" id="layanan">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-12">
      <div>
        <span class="font-label-md text-label-md text-secondary uppercase tracking-wider">{eyebrow}</span>
        <h2 class="font-headline-lg text-headline-lg text-on-surface mt-1">{heading}</h2>
      </div>
      <p class="font-body-md text-body-md text-on-surface-variant max-w-md">{subheading}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      {
        items.map((s) => {
          const style = variantStyles[s.variant] ?? variantStyles['narrow-muted'];
          return (
            <div
              class={`${style.colSpan} ${style.cardBg} border-2 border-on-surface shadow-[6px_6px_0_#111111] p-6 lg:p-8 flex flex-col justify-between gap-6`}
            >
              <div class="flex items-start justify-between gap-4">
                <span
                  class={`font-display-xl text-display-xl ${style.numClass} leading-none`}
                  style={style.numStroke ? '-webkit-text-stroke: 2px #1c1b1b;' : undefined}
                >
                  {s.num}
                </span>
                <span class={`font-label-sm text-label-sm ${style.tagClass} px-2.5 py-1 border-2 border-on-surface`}>
                  {s.tag}
                </span>
              </div>
              <div>
                <h3 class="font-headline-md text-headline-md text-on-surface mb-2">{s.title}</h3>
                <p class={`font-body-md text-body-md ${style.descClass}`}>{s.desc}</p>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
