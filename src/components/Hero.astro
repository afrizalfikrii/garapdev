---
import siteData from '../data/site.json';

const { hero } = siteData;
---

<section class="w-full py-12 lg:py-20 border-b-2 border-on-surface overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 lg:px-12 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
    <div class="lg:col-span-7 flex flex-col items-start gap-6">
      <div class="inline-block bg-secondary-container text-on-secondary-container font-label-md text-label-md px-3 py-1.5 border-2 border-on-surface shadow-[3px_3px_0_#111111] -rotate-2">
        {hero.badge}
      </div>
      <h1 class="font-display-xl text-display-xl text-on-surface tracking-tight">
        {hero.titleBefore}
        <span class="inline-block bg-primary-container text-on-surface px-3 py-0.5 border-2 border-on-surface shadow-[4px_4px_0_#111111] -rotate-1">
          {hero.titleHighlight}
        </span>
        {hero.titleAfter}
      </h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant max-w-xl">
        {hero.subtitle}
      </p>
      <div class="flex flex-wrap items-center gap-4 pt-2">
        <a
          class="inline-flex items-center gap-2 px-6 py-3.5 bg-primary-container text-on-surface font-label-lg text-label-lg border-2 border-on-surface shadow-[6px_6px_0_#111111] hover:translate-x-[-2px] hover:translate-y-[-2px] hover:shadow-[8px_8px_0_#111111] active:translate-x-[4px] active:translate-y-[4px] active:shadow-[2px_2px_0_#111111] transition-all"
          href="#cta-wa"
        >
          <span>{hero.primaryCta}</span>
          <span class="material-symbols-outlined text-[20px]">arrow_forward</span>
        </a>
        <a
          class="inline-flex items-center gap-2 px-6 py-3.5 bg-surface-container-lowest text-on-surface font-label-lg text-label-lg border-2 border-on-surface shadow-[6px_6px_0_#111111] hover:translate-x-[-2px] hover:translate-y-[-2px] hover:shadow-[8px_8px_0_#111111] active:translate-x-[4px] active:translate-y-[4px] active:shadow-[2px_2px_0_#111111] transition-all"
          href="#portofolio"
        >
          <span>{hero.secondaryCta}</span>
        </a>
      </div>
    </div>

    <div class="lg:col-span-5">
      <div class="bg-inverse-surface text-inverse-on-surface border-2 border-on-surface shadow-[8px_8px_0_#111111] rotate-1">
        <div class="flex items-center justify-between px-4 py-2.5 border-b-2 border-on-surface bg-on-surface">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-secondary-container border border-on-surface inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-primary-container border border-on-surface inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-tertiary-container border border-on-surface inline-block"></span>
          </div>
          <span class="font-label-sm text-label-sm text-surface-dim">{hero.terminal.host}</span>
        </div>
        <div class="p-5 font-label-md text-label-md space-y-2.5 min-h-[240px]">
          <p class="text-surface-dim">{hero.terminal.command}</p>
          <p class="text-primary-container">{hero.terminal.logs[0]}</p>
          <p class="text-inverse-on-surface">{hero.terminal.logs[1]}</p>
          <p class="text-tertiary-container">{hero.terminal.logs[2]}</p>
          <div class="pt-2 flex items-center gap-1 text-primary-container">
            <span>$</span>
            <span class="text-inverse-on-surface" id="terminal-typing" data-text={hero.terminal.typingText}>
              {hero.terminal.typingText}
            </span>
            <span class="inline-block w-2.5 h-4 bg-primary-container animate-pulse"></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const target = document.getElementById('terminal-typing');
  const text = target?.dataset.text ?? "git commit -m 'beres'";
  let index = 0;

  function typeNext() {
    if (!target) return;
    if (index <= text.length) {
      target.textContent = text.slice(0, index);
      index++;
      setTimeout(typeNext, 95);
    } else {
      setTimeout(() => {
        index = 0;
        typeNext();
      }, 2600);
    }
  }

  typeNext();
</script>
